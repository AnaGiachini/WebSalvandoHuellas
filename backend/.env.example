# Server
NODE_ENV=development
PORT=4000
FRONT_URL=http://localhost:3000
BACK_URL=http://localhost:4000

# Database: use either DATABASE_URL or the separated DB_* variables
DATABASE_URL=
DB_NAME=salvando_huellas
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSL=false

# Test database
TEST_DB_NAME=salvando_huellas_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=
TEST_DB_HOST=localhost
TEST_DB_PORT=5432

# Auth
JWT_SECRET=replace-with-a-long-random-secret
RESET_TOKEN_TTL=15m

# Mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_EMAIL=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Mercado Pago
MP_ACCESS_TOKEN=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_ANIMALES=salvando-huellas/animales
CLOUDINARY_FOLDER_PRODUCTOS=salvando-huellas/productos
